# ── Server ──
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# ── Database ──
DATABASE_URL=postgresql://optimas:optimas@localhost:5432/optimas_ms?schema=public

# ── Auth ──
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# ── Storage ──
UPLOAD_DIR=uploads
MAX_PHOTO_MB=8

# ── Work rules (Africa/Nairobi local time) ──
TZ_OFFSET_MINUTES=180
SHIFT_START=08:00
SHIFT_END=17:00
LATE_GRACE_MINUTES=15
CAPTURE_TTL_SECONDS=90
MIN_GPS_ACCURACY_M=100

# ── Office geofence for check-in/out (leave blank to disable) ──
OFFICE_LAT=-1.2921
OFFICE_LNG=36.8219
OFFICE_RADIUS_M=300

# ── Inventory controls ──
MAX_ROUTERS_IN_CUSTODY=5
CUSTODY_AGE_ALERT_DAYS=3

# ── Notifications ──
PUSH_ENABLED=true
# Optional: Expo access token if "enhanced push security" is enabled on your Expo account
EXPO_ACCESS_TOKEN=

# ── Production ──
# Number of reverse proxies in front of the API (1 when behind Caddy)
TRUST_PROXY=0
LOGIN_RATE_LIMIT=10

# ── Customer support contacts shown in the customer app ──
SUPPORT_PHONE=+254700000000
SUPPORT_WHATSAPP=254700000000
