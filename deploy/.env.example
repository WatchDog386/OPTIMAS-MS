# ─── Optimas MS production settings ─── copy to deploy/.env and edit ───

# Public address. With a domain pointing at the server you get HTTPS automatically:
#   SITE_ADDRESS=ms.optimas.co.ke
# Without a domain (testing only — Android release builds refuse plain HTTP by default):
SITE_ADDRESS=:80
ACME_EMAIL=it@optimas.co.ke

# Ports published on the VM. Keep 80/443 unless another service on this VM already uses them.
HTTP_PORT=80
HTTPS_PORT=443

# Database (generate with: openssl rand -hex 24)
POSTGRES_USER=optimas
POSTGRES_DB=optimas_ms
POSTGRES_PASSWORD=CHANGE_ME

# Auth (generate with: openssl rand -hex 48)
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=12h

# Work rules (company local time, Nairobi = UTC+3)
TZ_OFFSET_MINUTES=180
SHIFT_START=08:00
LATE_GRACE_MINUTES=15

# Office geofence for check-in/out — set to your office coordinates
OFFICE_LAT=-1.2921
OFFICE_LNG=36.8219
OFFICE_RADIUS_M=300

# Inventory controls
MAX_ROUTERS_IN_CUSTODY=5
CUSTODY_AGE_ALERT_DAYS=3

# Push notifications (Expo)
PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=

# Backups (written to deploy/backups on the VM by default)
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=1

# Customer app: support phone (tel) and WhatsApp number (digits only, international)
SUPPORT_PHONE=+254700000000
SUPPORT_WHATSAPP=254700000000
