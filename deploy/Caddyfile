# Optimas MS reverse proxy.
# SITE_ADDRESS=ms.example.co.ke  → automatic HTTPS via Let's Encrypt (recommended)
# SITE_ADDRESS=:80               → plain HTTP on the server IP (testing only)
{
	email {$ACME_EMAIL:admin@example.com}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# 'wasm-unsafe-eval' lets the barcode reader (WebAssembly) start; JavaScript eval stays blocked
		# Only our own scripts run; nobody can frame the app (clickjacking); map tiles and photos are images
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; worker-src 'self'; manifest-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		# The app needs the camera (proof photos, scanning) and location; nothing else
		Permissions-Policy "camera=(self), geolocation=(self), microphone=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-X-Powered-By
	}

	# API (photos are uploaded here, so allow large bodies)
	handle /api/* {
		request_body {
			max_size 12MB
		}
		reverse_proxy api:4000
	}
	handle /health {
		reverse_proxy api:4000
	}

	# Manager web console (Expo web build, single-page app)
	handle {
		# Hashed bundles never change: cache for a year. Everything else (index.html, sw.js, manifest,
		# version.json, icons) must be revalidated so installed apps pick up new releases immediately.
		@immutable path /_expo/static/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@mutable not path /_expo/static/*
		header @mutable Cache-Control "no-cache"
		root * /srv/web
		try_files {path} {path}.html /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
