# Copy to deploy/monitor.env and fill in. Then: bash deploy/monitor.sh --install

# Where alerts go. The easy way: install the free "ntfy" app on your phone, pick a private topic name,
# and use https://ntfy.sh/<your-topic>. Slack or Mattermost incoming-webhook URLs work too (set ALERT_FORMAT=json).
ALERT_URL=https://ntfy.sh/optimas-alerts-change-this-name
ALERT_FORMAT=ntfy

# What to check
SITE_URL=http://127.0.0.1/health
DISK_WARN_PCT=85
BACKUP_MAX_AGE_H=30
