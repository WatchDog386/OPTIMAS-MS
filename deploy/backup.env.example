# Off-site backups. Copy this file to deploy/backup.env, fill it in, then: bash deploy/deploy.sh
# Backups are copied here after every nightly run; the newest 60 days are kept.

# Where to copy to: "<name>:<bucket-or-folder>". The <name> must match the RCLONE_CONFIG_<NAME>_ lines below.
BACKUP_REMOTE=offsite:optimas-backups
BACKUP_REMOTE_KEEP_DAYS=60

# Example: any S3-compatible storage (Backblaze B2, Wasabi, AWS S3, DigitalOcean Spaces…)
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Other
RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=your-key-id
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=your-application-key

# Other places work too (Google Drive, OneDrive, another server over SFTP): see https://rclone.org/docs/
